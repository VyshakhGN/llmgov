@startuml component
skinparam componentStyle uml2
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 75
skinparam ranksep 100
skinparam defaultTextAlignment center
skinparam rectangle<<column>> {
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
  StereotypeFontColor transparent
  FontSize 1
  StereotypeFontSize 1
}
skinparam rectangle<<spacer>> {
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
  StereotypeFontColor transparent
}
title cmp Component Diagram

rectangle "RAG Refund Response Automation System" {

  rectangle "top" <<column>> {
    component "Refund case UI" <<frontend>> as UI_CASE
    component "Human review UI" <<frontend>> as UI_REVIEW
    component "Human Review Queue" <<review queue>> as QUEUE
  }

  rectangle "inputs" <<column>> {
    database "Test cases + gold labels" <<dataset>> as CASES
    database "Order & customer DB" <<database>> as ORDERDB
  }
  component "\n\nFastAPI Orchestrator\n(pipeline runner)\n\n                                                                  " <<REST API>> as ORCH

  rectangle "eval" <<column>> {
    rectangle "x" <<spacer>> as SPACER
    component "Evaluation" <<service>> as EVAL
    database "Routing logs" <<log store>> as LOGS
  }

  rectangle "policy" <<column>> {
    component "Backend policy engine" <<service>> as POL
    rectangle "x" <<spacer>> as SPACER2
    component "Refund Policy Rules Store" <<rules repository>> as RULES
  }

  rectangle "routing" <<column>> {
    component "Routing decision engine" <<decision service>> as ROUTE
    component "Guideline retriever" <<retrieval service>> as RET
    database "Refund guidelines index" <<vector store>> as VEC
    component "Embedding Model" <<model service>> as EMB
    artifact "Refund guidelines PDF" <<document>> as PDF
  }

  rectangle "drafting" <<column>> {
    component "Draft response generator" <<LLM service>> as DRAFT
    component "PII masking" <<service>> as RISK
  }

  rectangle "extraction" <<column>> {
    component "Order number extractor" <<LLM service>> as EXT
    component "LLM Service" <<AI service>> as LLM
  }

}

UI_CASE -down(0- ORCH : IRefundCaseAPI
UI_REVIEW -down(0- ORCH : IHumanReviewAPI
ORCH -up(0- QUEUE : IReviewQueue

ORCH -left(0- CASES : ICaseSet

ORCH -right(0- EVAL : IEvaluation
SPACER -[hidden]right- EVAL
POL -[hidden]right- SPACER2
EVAL -down(0- LOGS : IRoutingLogStore
ORCH -down(0- LOGS : IRoutingLogStore

ORCH -down(0- POL : IPolicyDecision
ORCH -down(0- "IRoutingDecision" ROUTE

ORCH -down(0- "IDraftGeneration" DRAFT
EXT -up0)- "IOrderExtraction" ORCH
ORCH -down(0- ORDERDB : IOrderFactsStore


POL -down(0- "IRefundPolicyRules" RULES
ROUTE -down(0- RET : IGuidelineRetrieval
ROUTE -down(0- RISK : IPiiMasking
DRAFT -down(0- RISK : IPiiMasking
DRAFT -[norank](0- POL : IPolicyDecision
ROUTE -down(0- "ILLMCompletion" LLM
DRAFT -down(0- "ILLMCompletion" LLM
EXT "ILLMCompletion" -down(0- LLM

RET -down(0- VEC : IGuidelineStore
RET -down(0- EMB : IEmbedding
VEC -down(0- PDF : IGuidelineDocument
@enduml
