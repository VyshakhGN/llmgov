@startuml sequence
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ParticipantPadding 10
skinparam ParticipantBackgroundColor #F1F1F1
skinparam DatabaseBackgroundColor #F1F1F1
hide footbox
title sd Refund case run

participant "Refund case UI" as UI <<frontend>>
participant "FastAPI\nOrchestrator" as ORCH <<REST API>>
participant "Order number\nextractor" as EXT <<LLM service>> #DDEBF7
database "Order &\ncustomer DB" as DB <<database>>
participant "Backend policy\nengine" as POL <<service>>
participant "Draft response\ngenerator" as DRAFT <<LLM service>> #DDEBF7
participant "Routing decision\nengine" as ROUTE <<decision service>> #DDEBF7
participant "Guideline\nretriever" as RET <<retrieval service>>
participant "LLM Service" as LLM <<AI service>> #DDEBF7
database "Routing logs" as LOGS <<log store>>

autonumber "<b>0:"

UI -> ORCH : run_start(mode, top_k, case_ids)
activate ORCH

ORCH -> DB : load_orders(path, customers)
DB --> ORCH : orders

loop for each selected case

  ORCH -> EXT : extract(message)
  activate EXT
  EXT -> LLM : chat(prompt)
  LLM --> EXT : response
  EXT --> ORCH : order_id
  deactivate EXT

  ORCH -> ORCH : orders.get(order_id)

  ORCH -> POL : decide(facts)
  POL --> ORCH : decision

  ORCH -> DRAFT : write(case)
  activate DRAFT
  DRAFT -> LLM : chat(prompt)
  LLM --> DRAFT : response
  DRAFT --> ORCH : draft
  deactivate DRAFT

  ORCH -> ROUTE : route(case, risk_signals)
  activate ROUTE
  group opt <U+2007><U+2007><U+2007>[RAG mode]
    ROUTE -> RET : search_many(queries, k)
    RET --> ROUTE : top k guidelines
  end
  ROUTE -> LLM : chat(prompt)
  LLM --> ROUTE : response
  ROUTE --> ORCH : RoutingDecision
  deactivate ROUTE

end

ORCH -> LOGS : write_traces(traces, path)
ORCH --> UI : DONE /runs/{run_id}
deactivate ORCH
@enduml
